# ==============================================================================
# CYBERDECK OS - Configuration Environment Variables
# ==============================================================================

# OS & Image Metadata
IMG_NAME="CyberDeckOS"
RELEASE_VERSION="v0.1.0"
DEPLOY_DIR="deploy"

# Target Architecture & Base
TARGET_ARCH="armhf"
BASE_DISTRO="bookworm"

# System Credentials & Host Information
TARGET_HOSTNAME="cyberdeck"
FIRST_USER_NAME="deck"
FIRST_USER_PASS="cyberdeck"

# Localization
KEYBOARD_KEYMAP="us"
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT="UTC"
LOCALE_DEFAULT="en_US.UTF-8"

# Hardware Interfaces
ENABLE_SSH=1
ENABLE_SPI=1
ENABLE_I2C=1
ENABLE_UART=1
ENABLE_CAMERA=0

# Display Configuration (3.5 inch 480x320 SPI TFT - XPT2046)
DISPLAY_TYPE="tft35a"
DISPLAY_ROTATE=90
TOUCH_CONTROLLER="ads7846"
TOUCH_SWAPXY=1
TOUCH_INVERT_X=0
TOUCH_INVERT_Y=1

# Memory & Performance Optimizations (Raspberry Pi 3B with 1GB RAM)
GPU_MEM=64
DISABLE_SPLASH=1
BOOT_DELAY=0
OPTIMIZE_SD_CARD_LOGGING=1

# Companion Microcontroller (ESP32)
ESP32_DEFAULT_BAUD=115200
ESP32_AUTO_CONNECT=1
