[Unit]
Description=CyberDeck OS - 3.5 Inch Touchscreen User Interface
After=network.target sound.target systemd-udevd.service
Wants=network.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=deck
Group=deck
WorkingDirectory=/opt/cyberdeck
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=SDL_FBDEV=/dev/fb1
Environment=SDL_VIDEODRIVER=fbcon
Environment=SDL_MOUSEDRV=TSLIB
Environment=SDL_MOUSEDEV=/dev/input/touchscreen
ExecStart=/usr/bin/python3 /opt/cyberdeck/ui/main.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cyberdeck-ui

# Sandboxing & Resource constraints suitable for RPi3
CPUWeight=100
MemoryMax=350M

[Install]
WantedBy=multi-user.target
