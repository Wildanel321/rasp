# ==============================================================================
# CYBERDECK OS - UDEV Rules for Touchscreen & Serial Devices
# ==============================================================================

# ADS7846 / XPT2046 Touchscreen input symlink
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="ADS7846 Touchscreen", SYMLINK+="input/touchscreen", MODE="0660", GROUP="input"

# Generic USB-to-UART Serial Devices for ESP32
KERNEL=="ttyUSB*", MODE="0666", GROUP="dialout"
KERNEL=="ttyACM*", MODE="0666", GROUP="dialout"

# GPIO Memory access
SUBSYSTEM=="bcm2835-gpiomem", MODE="0660", GROUP="gpio"
SUBSYSTEM=="gpio", MODE="0660", GROUP="gpio"
